{
  "name": "ai-usage-dashboard",
  "version": "1.0.2",
  "license": "MIT",
  "description": "Claude usage dashboard mock for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.usageai.dashboard",
    "productName": "UsageAI",
    "artifactName": "UsageAI-${version}-portable.${ext}",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release*{,/**}",
      "!dist{,/**}"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ]
    }
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1"
  }
}
